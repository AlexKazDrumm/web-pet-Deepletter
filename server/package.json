{
  "name": "@deepletter/server",
  "version": "1.0.0",
  "private": true,
  "description": "Deepletter API — каталог инструментов и анализ документов",
  "author": "AlexKazDrumm <alexkazdrumm@gmail.com>",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.cjs up",
    "migrate:down": "node scripts/migrate.cjs down",
    "seed": "node scripts/seed.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepletter/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.0"
  }
}
