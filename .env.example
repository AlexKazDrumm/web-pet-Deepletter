# PostgreSQL
POSTGRES_USER=deepletter
POSTGRES_PASSWORD=deepletter
POSTGRES_DB=deepletter

# Порт PostgreSQL на хосте
DB_PORT=5432

# Подключение API и миграций
DATABASE_URL=postgres://deepletter:deepletter@localhost:5432/deepletter

# API
NODE_ENV=development
PORT=3030

WEB_ORIGIN=http://localhost:3000

# Максимальный размер файла в байтах
MAX_UPLOAD_BYTES=5242880

# Ограничение частоты запросов
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ANALYZE_RATE_LIMIT_MAX=20

# Клиент
NEXT_PUBLIC_API_BASE_URL=http://localhost:3030

# API для серверных запросов Next.js
API_BASE_URL=http://localhost:3030
